<h1>New restaurant</h1>

<%= form_with model: @restaurant, url: restaurants_path do |f| %>
  <%= f.label :name %>
  <%= f.text_field :name %>

  <%= f.label :address %>
  <%= f.text_area :address %>

  <%= f.label :phone_number %>
  <%= f.text_field :phone_number %>

  <%= f.label :categorie %>
  <%= f.text_field :categorie %>

  <%= f.submit %>
<% end %>

<%= link_to "Back to restaurants", restaurants_path %>
