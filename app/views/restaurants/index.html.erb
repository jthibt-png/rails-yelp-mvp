<h1>Restaurants</h1>

<% @restaurants.each do |restaurant| %>
  <h2><%= restaurant.name %></h2>
  <p><%= restaurant.address %></p>
  <p><%= restaurant.category %></p>

  <h3>Reviews</h3>

  <% restaurant.reviews.each do |review| %>
    <p><%= review.rating %>/5</p>
    <p><%= review.content %></p>
  <% end %>
<% end %>
